# Keys can also be set from Settings (gear icon) in the app; it checks them and writes this file.
# Without any key SAQR still runs local tools and GeoCLIP (MIT). StreetCLIP stays off.

# OpenRouter: one key for models from every lab (openrouter.ai/keys)
OPENROUTER_API_KEY=
# Anthropic: Claude direct (console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional
# SAQR_PROVIDER=openrouter            # openrouter | anthropic, when both keys are saved
# SAQR_OR_MODEL=anthropic/claude-opus-5.5
# SAQR_MODEL=claude-opus-5-5          # model for the Anthropic provider
# SAQR_EFFORT=high
# SAQR_MAX_TURNS=40
# SAQR_CASES=D:\path\to\cases         # where case folders go (default: saqr\cases)
# SAQR_GEOINT=C:\path\to\geoint       # the geoint skill (default: %USERPROFILE%\.claude\skills\geoint)
# SAQR_PORT=8765
# SAQR_WORKERS=2                  # analyses running at once (1–8). Extra uploads wait.
# SAQR_ALLOW_NC_MODELS=1          # private opt-in: also load StreetCLIP (CC-BY-NC). Default runs GeoCLIP only.
# SAQR_GOOGLE_KEY=                # or GOOGLE_MAPS_API_KEY: unlocks Google Street View and Google tiles only
# SAQR_APPLE_KEY=
# SAQR_BING_KEY=
# SAQR_YANDEX_KEY=
